# Copy to .env before running docker compose

# Backend
BACKEND_PORT=3002
# If DB runs in a separate project on the same host, use host.docker.internal.
# If DB runs elsewhere, use its host/IP directly.
DATABASE_URL=postgresql://postgres:change_me@host.docker.internal:5432/employee_tracker
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me_too
