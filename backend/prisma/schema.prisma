generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Manager {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  googleAuthId          String    @unique @map("google_auth_id")
  email                 String    @unique
  fullName              String    @map("full_name")
  picture               String?
  companyName           String?   @map("company_name")
  companyLogoUrl        String?   @map("company_logo_url")
  preferences           Json?
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  tokenVersion          Int       @default(0) @map("token_version")

  employees             Employee[]
  shifts                Shift[]

  @@map("managers")
}

model Employee {
  id           String         @id @default(uuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  managerId    String         @map("manager_id")
  firstName    String         @map("first_name")
  lastName     String         @map("last_name")
  age          Int
  hourlyRate   Decimal        @db.Decimal(10, 2) @map("hourly_rate")
  status       EmployeeStatus @default(ACTIVE)

  manager      Manager        @relation(fields: [managerId], references: [id], onDelete: Cascade)
  assignments  ShiftAssignment[]

  @@index([managerId])
  @@map("employees")
}

model Shift {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managerId    String   @map("manager_id")
  date         DateTime @db.Date
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time

  manager      Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  assignments  ShiftAssignment[]

  @@index([managerId, date])
  @@map("shifts")
}

model ShiftAssignment {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shiftId         String   @map("shift_id")
  employeeId      String   @map("employee_id")
  calculatedHours Decimal  @db.Decimal(5, 2) @map("calculated_hours")

  shift           Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([shiftId, employeeId])
  @@index([employeeId])
  @@map("shift_assignments")
}
