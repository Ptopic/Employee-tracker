# App runtime
EXPO_PUBLIC_API_URL=https://backend.example.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# iOS / App Store Connect (base64-encoded .p8 content)
FASTLANE_API_KEY_ID=ABCD123456
FASTLANE_API_ISSUER_ID=00000000-0000-0000-0000-000000000000
FASTLANE_API_KEY=BASE64_ENCODED_APP_STORE_CONNECT_P8_CONTENT
FASTLANE_BUNDLE_IDENTIFIER=com.petartopic.saveit
FASTLANE_TEAM_ID=
IOS_SCHEME=saveit
IOS_WORKSPACE=ios/saveit.xcworkspace
IOS_XCODEPROJ=ios/saveit.xcodeproj
IOS_OUTPUT_DIR=build/ios
IOS_OUTPUT_NAME=saveit.ipa
IOS_SKIP_WAITING_FOR_BUILD_PROCESSING=true

# Android / Google Play
PLAY_STORE_JSON_KEY_PATH=/absolute/path/to/google-play-service-account.json
PLAY_STORE_PACKAGE_NAME=com.petartopic.saveit
PLAY_STORE_TRACK=internal
PLAY_STORE_RELEASE_STATUS=draft
ANDROID_RELEASE_KEYSTORE_PATH=/absolute/path/to/upload-keystore.jks
ANDROID_RELEASE_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_RELEASE_KEY_ALIAS=your_key_alias
ANDROID_RELEASE_KEY_PASSWORD=your_key_password
